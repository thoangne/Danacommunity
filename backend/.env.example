# ==============================================================================
# Backend Environment Configuration Template
# ==============================================================================
# For Local Development:
# Copy this file to backend/.env and adjust if needed.
#
# For Production (Google Cloud Run):
# Set these as environment variables or secrets via Google Secret Manager.
# Real credentials must NEVER be committed to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Local Development (Host machine connecting to Docker PostgreSQL container):
DATABASE_URL=postgresql://champa_user:champa_password@localhost:5432/champa_dev

# When running backend inside Docker Compose network:
# DATABASE_URL=postgresql://champa_user:champa_password@postgres:5432/champa_dev

# Production (Google Cloud Run connecting to Supabase PostgreSQL):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or via Google Secret Manager: DATABASE_URL=<INJECTED_FROM_SECRET_MANAGER>

# Database Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# Optional SSL override (true/false) - defaults to false in dev, true in prod / Supabase
# DB_SSL=false

# ------------------------------------------------------------------------------
# Supabase API (Optional for direct PostgreSQL, required for Auth/Storage SDK)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# ------------------------------------------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Google Cloud Console Credentials)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ------------------------------------------------------------------------------
# Facebook OAuth 2.0 (Meta for Developers Credentials)
# ------------------------------------------------------------------------------
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ------------------------------------------------------------------------------
# Application URLs (CORS & OAuth Redirect Whitelist)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

