# ==============================================================================
# Local Docker Compose Environment Configuration
# ==============================================================================
# Use this file to configure environment variables for Docker Compose services.
# Copy this file to .env in the root directory if customizing values.

POSTGRES_DB=champa_dev
POSTGRES_USER=champa_user
POSTGRES_PASSWORD=champa_password
POSTGRES_PORT=5432

# ==============================================================================
# OAuth 2.0 Authentication Configuration
# ==============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# JWT & Authentication Secret
JWT_SECRET=

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000


